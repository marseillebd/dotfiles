# shellcheck shell=bash

# The first thing I want to do is ensure my bash environment is an extension of my sh environment.
# Thus, we begin by sourcing `~/.profile`, which does the startup for sh.
if [[ -f "$HOME/.profile" ]]; then
  # shellcheck disable=SC1090
  . "$HOME/.profile"
fi

# The rest of the startup is useful for interactive shells only.
# Scripts will not benefit from them, and indeed may have their behavoir unexpectedly altered.
# If not running interactively, don't do anything.
case "$-" in
  *i*) ;;
  *) return ;;
esac

# A helper function for loading the different "stages" of my rc files.
__bashrc_stage() {
  local stage="$1"
  local f
  if [ -f "$XDG_CONFIG_HOME/shell/${stage}.sh" ]; then
    . "$XDG_CONFIG_HOME/shell/${stage}.sh"
  fi
  if [ -d "$XDG_CONFIG_HOME/shell/${stage}.d/" ]; then
    for f in "$XDG_CONFIG_HOME/shell/${stage}.d/"*".sh"; do
      [ -f "$f" ] && . "$f"
    done
  fi
  if [ -f "$XDG_CONFIG_HOME/shell/${stage}.bash" ]; then
    . "$XDG_CONFIG_HOME/shell/${stage}.bash"
  fi
  if [ -d "$XDG_CONFIG_HOME/shell/${stage}.d/" ]; then
    for f in "$XDG_CONFIG_HOME/shell/${stage}.d/"*".bash"; do
      [ -f "$f" ] && . "$f"
    done
  fi
}

########################
###### run stages ######
########################

# basic environment variable settings, shell settings, and colors
__bashrc_stage env

# shell completions, first gloabl, then local
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        # shellcheck disable=SC1091
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        # shellcheck disable=SC1091
        . /etc/bash_completion
    fi
    for rc in "${XDG_CONFIG_HOME}/"{shell,bash}"/completion"/*.bash; do
      [ -f "$rc" ] || continue
      # shellcheck disable=SC1090
      . "$rc"
    done
fi

__bashrc_stage completion

# aliases last, so that they don't interfere with other setup actions
# also sets up utility functions, and programs that integrate with the shell

__bashrc_stage alias

