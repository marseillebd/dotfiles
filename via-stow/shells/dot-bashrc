# shellcheck shell=bash

# The first thing I want to do is ensure my bash environment is an extension of my sh environment.
# Thus, we begin by sourcing `~/.profile`, which does the startup for sh.
if [[ -f "$HOME/.profile" ]]; then
  # shellcheck disable=SC1090
  . "$HOME/.profile"
fi

# The rest of the startup is useful for interactive shells only.
# Scripts will not benefit from them, and indeed may have their behavoir unexpectedly altered.
# If not running interactively, don't do anything.
case "$-" in
  *i*) ;;
  *) return ;;
esac

###################################
###### environment variables ######
###################################

. "$XDG_CONFIG_HOME/shell/env.sh"
for __f in "$XDG_CONFIG_HOME/shell/env.d/"*".sh"; do
  [ -f "$__f" ] && . "$__f"
done
. "$XDG_CONFIG_HOME/shell/env.bash"
for __f in "$XDG_CONFIG_HOME/shell/env.d/"*".bash"; do
  [ -f "$__f" ] && . "$__f"
done

#########################
###### completions ######
#########################

# setup programmable completion
# each program should put its completions in its own file
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        # shellcheck disable=SC1091
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        # shellcheck disable=SC1091
        . /etc/bash_completion
    fi
    for rc in "${XDG_CONFIG_HOME}/"{shell,bash}"/completion"/*.bash; do
      [ -f "$rc" ] || continue
      # shellcheck disable=SC1090
      . "$rc"
    done
fi

. "$XDG_CONFIG_HOME/shell/completion.sh"
for __f in "$XDG_CONFIG_HOME/shell/completion.d/"*".sh"; do
  [ -f "$__f" ] && . "$__f"
done
. "$XDG_CONFIG_HOME/shell/completion.bash"
for __f in "$XDG_CONFIG_HOME/shell/completion.d/"*".bash"; do
  [ -f "$__f" ] && . "$__f"
done

#####################
###### aliases ######
#####################

# set up aliases last so that they don't interfere with other setup actions
# also sets up utility functions, and programs that integrate with the shell

. "$XDG_CONFIG_HOME/shell/alias.sh"
for __f in "$XDG_CONFIG_HOME/shell/alias.d/"*".sh"; do
  [ -f "$__f" ] && . "$__f"
done
. "$XDG_CONFIG_HOME/shell/alias.bash"
for __f in "$XDG_CONFIG_HOME/shell/alias.d/"*".bash"; do
  [ -f "$__f" ] && . "$__f"
done

# Installers keep wanting to add stuff directly to my version-controlled dotfiles.
# They should all stop it!
# Thankfully, they seem to just append stuff, so it's easy to detect after the fact.
# NOTHING BEYOND THIS POINT
