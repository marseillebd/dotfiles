# shellcheck shell=sh

# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login
# exists.
# see /usr/share/doc/bash/examples/startup-files for examples.
# the files are located in the bash-doc package.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

# WARNING the path given here must agree with the config path given in path.sh
confdir="${XDG_CONFIG_HOME:-$HOME/.config}"

# Set up XDG base directories.
if [ -f "$confdir/profile/path.sh" ]; then
  # shellcheck disable=SC1090
  . "$confdir/profile/path.sh"
fi

unset confdir

# outside of paths, everything else is used for interactive shells, and so should go in:
# - `$XDG_CONFIG_HOME/shell/` for shell-generic configuration (well, anything posix sh compatible)
# - `$XDG_CONFIG_HOME/bash/` for bash-specific configuration
# - and so on for other shells
